# ───────────────────────────────────────────────
# FocusOn Backend — Environment Variables
# ───────────────────────────────────────────────

# SMTP Email Configuration (required for sending emails)
# ── For Rediffmail (FREE) ──
SMTP_HOST=smtp.rediffmail.com
SMTP_PORT=25
SMTP_USER=yourname@rediffmail.com
SMTP_PASS=your-rediffmail-password
# SMTP_SECURE=false  (port 25 doesn't use SSL)

# ── For Rediffmail PRO ── (Use this if free doesn't work)
# SMTP_HOST=smtp.rediffmailpro.com
# SMTP_PORT=587
# SMTP_SECURE=false

SMTP_FROM=FocusOn Interiors <yourname@rediffmail.com>

# Where to send contact form submissions
TO_EMAIL=info@focusoninterior.in

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://roushan62.github.io

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5

# Server port
PORT=3001
